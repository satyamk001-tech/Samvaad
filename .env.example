# ==========================================
# VIORA PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# SERVER CONFIGURATION
PORT=8080
SPRING_PROFILES_ACTIVE=dev
CLIENT_ORIGIN_URL=http://localhost:5173

# DATABASE CONFIGURATION (POSTGRESQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vioradb
POSTGRES_USER=viora
POSTGRES_PASSWORD=viora_secret_pass

# REDIS CONFIGURATION (PRESENCE & CACHING)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# KAFKA EVENT BUS CONFIGURATION
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=viora-group

# AUTHENTICATION & JWT SECURITY
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 Days

# STORAGE CONFIGURATION (LOCAL / S3)
STORAGE_TYPE=LOCAL                  # Options: LOCAL | S3
STORAGE_LOCAL_DIR=./uploads
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WEBRTC STUN / TURN CONFIGURATION
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=viora_user
TURN_CREDENTIAL=viora_turn_pass
